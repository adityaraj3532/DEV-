# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAILS=owner@example.com
DATABASE_PATH=shop.db
# Local development only: console prints OTP in the backend terminal.
# Use smtp and COOKIE_SECURE=true with HTTPS for live use.
OTP_MODE=console
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8081
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=owner@gmail.com
SMTP_PASSWORD=your-email-provider-app-password
SMTP_FROM=owner@gmail.com
