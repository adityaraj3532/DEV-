# Copy to frontend/.env (never commit .env). Real environment variables override these.

# --- Server (npm start / hosting) ---
# HOST=0.0.0.0          # listen on all interfaces (needed on a server / for phones on your Wi-Fi)
# PORT=8080
# ADMIN_KEY=choose-a-long-random-key
# TRUST_PROXY=1         # set when behind Render/Railway/Nginx
# CORS_ORIGINS=         # extra allowed origins, comma separated (the Android app is allowed by default)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Dev Computer <you@gmail.com>

# --- Android app build (npm run android:sync / android:apk) ---
# The public https address of your hosted server, e.g. https://dev-computer.onrender.com
# API_URL=
